{
  "name": "club-lectura-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../.env prisma/seed.ts",
    "start:docker": "npm run db:deploy && node dist/prisma/seed.js && npm start"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
